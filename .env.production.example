APP_NAME=Customyzables
APP_ENV=production
APP_DEBUG=false

# Generate one with: php artisan key:generate --show
APP_KEY=

# Change to the real URL after the host gives you one (https://...)
APP_URL=http://localhost:8080

# --- Database ---------------------------------------------------------------
# For docker compose the host is the service name "db".
# On Railway use the MySQL plugin values; on cPanel use the host it gives you.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=customyzables
DB_USERNAME=customyzables
DB_PASSWORD=secret

# --- Runtime ----------------------------------------------------------------
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Send logs to the platform's log stream instead of a file.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Set to true only on the very first deploy, to load the demo accounts.
SEED_DATABASE=false
